{
  "id": "/studio/",
  "name": "LocalEditor Design",
  "short_name": "LE Design",
  "description": "The LocalEditor design studio on its own: photos, layouts, collages and text. Everything stays on your device and works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./studio/?app=design",
  "scope": "./studio/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#FAFAFA",
  "theme_color": "#161616",
  "categories": [
    "photo",
    "graphics",
    "design"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "type": "image/webp",
      "src": "assets/screenshots/studio-narrow.webp",
      "sizes": "780x1688",
      "form_factor": "narrow",
      "label": "The photo studio on a phone: layers, text and filters, all on your device"
    },
    {
      "type": "image/webp",
      "src": "assets/screenshots/studio-wide.webp",
      "sizes": "1440x900",
      "form_factor": "wide",
      "label": "Design with layers, templates and collages"
    }
  ],
  "shortcuts": [
    {
      "name": "New design",
      "short_name": "New",
      "description": "Start a new design",
      "url": "./studio/?app=design",
      "icons": [
        {
          "src": "assets/icons/shortcuts/studio-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Make a collage",
      "short_name": "Collage",
      "description": "Arrange several photos",
      "url": "./studio/?tool=collage&app=design",
      "icons": [
        {
          "src": "assets/icons/shortcuts/collage-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Remove a background",
      "short_name": "Cut out",
      "description": "Cut out a photo on this device",
      "url": "./studio/?tool=cutout&app=design",
      "icons": [
        {
          "src": "assets/icons/shortcuts/studio-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./studio/?app=design",
      "accept": {
        "application/vnd.localeditor.project+zip": [
          ".leproject"
        ],
        "application/vnd.localeditor.design+json": [
          ".ledesign.json"
        ],
        "application/vnd.localeditor.workflow+json": [
          ".leworkflow"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/avif": [
          ".avif"
        ]
      },
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./studio/?share-target=1&app=design",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            ".leproject",
            ".ledesign.json",
            ".leworkflow"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  }
}
