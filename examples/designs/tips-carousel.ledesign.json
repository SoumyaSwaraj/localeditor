        { "id": "tip-2-body", "type": "text", "text": "Turn your subject toward a window. Soft side light flatters faces more than any filter.", "font": "DM Sans", "weight": 400, "size": 46, "lineHeight": 1.4, "color": "#2E5442", "x": 100, "y": 560, "w": 860 },
        { "id": "tip-2-icon", "type": "icon", "icon": "lucide:sun", "color": "#1F3A2E", "strokeWidth": 1.5, "x": 100, "y": 1080, "w": 110 }
