        { "id": "tip-1-body", "type": "text", "text": "Pockets leave a film on the glass. One wipe with a soft cloth turns hazy photos crisp.", "font": "DM Sans", "weight": 400, "size": 46, "lineHeight": 1.4, "color": "#2E5442", "x": 100, "y": 560, "w": 860 },
        { "id": "tip-1-icon", "type": "icon", "icon": "lucide:sparkles", "color": "#1F3A2E", "strokeWidth": 1.5, "x": 100, "y": 1080, "w": 110 }
